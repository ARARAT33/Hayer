# HAYER Backend Configuration
# Copy this file to .env and fill in the values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hayer
DB_USER=hayer
DB_PASSWORD=your_secure_password
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_256_bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your_session_secret_key
SESSION_COOKIE_NAME=hayer_session
SESSION_COOKIE_MAX_AGE=86400000

# WebAuthn/Passkey Configuration
WEBAUTHN_RP_NAME=HAYER
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_ATTESTATION=none

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE="Too many requests, please try again later"

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization

# Security Headers
HELMET_CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_FILE_NAME=hayer-backend
LOG_MAX_SIZE=10m
LOG_MAX_FILES=10

# Storage Configuration
STORAGE_ENCRYPTION_KEY=your_32_byte_encryption_key_base64
STORAGE_CHUNK_SIZE=4194304
STORAGE_REPLICA_COUNT=3
STORAGE_MIN_NODES_FOR_QUORUM=2

# Node Network Configuration
NODE_REGISTRY_URL=http://localhost:3000/api/nodes
NODE_HEALTH_CHECK_INTERVAL=60000
NODE_TIMEOUT_MS=10000
NODE_MAX_RETRIES=3

# OAuth Configuration
OAUTH_STATE_SECRET=your_oauth_state_secret
OAUTH_TOKEN_SECRET=your_oauth_token_secret

# Admin Configuration
ADMIN_EMAIL=admin@hayer.local
ADMIN_PASSWORD=your_admin_password
ADMIN_INITIALIZED=false

# Registry Configuration
REGISTRY_SOURCES=https://raw.githubusercontent.com/ARARAT33/Hayer/main/registry.json
REGISTRY_CACHE_TTL=3600000
REGISTRY_SIGNATURE_SECRET=your_registry_signature_secret

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_PORT=9090

# Feature Flags
FEATURE_PASSKEYS=true
FEATURE_MFA=true
FEATURE_OAUTH=true
FEATURE_SSO=true
FEATURE_STORAGE=true
FEATURE_FEDERATION=true
