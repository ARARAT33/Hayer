{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hayer federated service registry",
  "type": "object",
  "required": ["version", "generatedAt", "nodes"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "url"],
        "properties": {
          "id": { "type": "string", "maxLength": 180 },
          "name": { "type": "string", "maxLength": 100 },
          "type": { "enum": ["mastodon", "matrix", "lemmy", "peertube", "pixelfed", "xmpp", "nextcloud", "discourse", "mobilizon", "zulip", "humhub", "rocketchat"] },
          "url": { "type": "string", "format": "uri" },
          "statusUrl": { "type": "string", "format": "uri" },
          "region": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}